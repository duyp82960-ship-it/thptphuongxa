# ==============================================================================
# ENVIRONMENT CONFIGURATION (.env.example)
# Note: Do not commit actual production secrets to Git.
# ==============================================================================

# Database Configuration (Supabase / Backend Services)
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key-placeholder"

# GEMINI_API_KEY: Required for Gemini AI API features (auto-injected in AI Studio)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The hosting URL of the application
APP_URL="MY_APP_URL"
